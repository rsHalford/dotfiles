command = /usr/bin/fish
confirm-close-surface = false
quit-after-last-window-closed = false
shell-integration-features = no-cursor,sudo,title
window-inherit-working-directory = false
tab-inherit-working-directory = true
split-inherit-working-directory = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s
theme = Kanagawa Wave
font-family = CascadiaCode
font-size = 14
background-opacity = 0.95
keybind = resize/arrow_up=resize_split:up,10
keybind = resize/arrow_down=resize_split:down,10
keybind = resize/arrow_left=resize_split:left,10
keybind = resize/arrow_right=resize_split:right,10
keybind = resize/escape=deactivate_key_table
keybind = resize/catch_all=ignore
keybind = ctrl+a=activate_key_table:resize
keybind = ctrl+up=goto_split:up
keybind = ctrl+down=goto_split:down
keybind = ctrl+left=goto_split:left
keybind = ctrl+right=goto_split:right
keybind = ctrl+n=goto_split:next
keybind = ctrl+p=goto_split:previous
keybind = alt+up=new_split:up
keybind = alt+down=new_split:down
keybind = alt+left=new_split:left
keybind = alt+right=new_split:right
