#!/usr/bin/env bash

HELIX_TEMPLATE="$HOME/.config/helix/config.template.toml"
HELIX_CONFIG="$HOME/.config/helix/config.toml"
ZELLIJ_DIR="$HOME/.config/zellij"
ZELLIJ_CONFIG="$ZELLIJ_DIR/config.kdl"
ZELLIJ_DYNAMIC_THEME="$ZELLIJ_DIR/themes/dynamic.kdl"

load_theme_registry() {
  if [[ "$1" == "dark" ]]; then
    GTK_THEME="adw-gtk3-dark"
    GTK_SCHEME="prefer-dark"
    HELIX_THEME="kanagawa"
    FG="#DCD7BA"
    BG="#1F1F28"
    BLK="#090618"
    RED="#C34043"
    GRN="#76946A"
    YLW="#C0A36E"
    BLU="#7E9CD8"
    MAG="#957FB8"
    CYN="#6A9589"
    WHT="#C8C093"
    ORG="#FFA066"
    NOTIFY_ICON="weather-clear-night"
  else
    GTK_THEME="adw-gtk3"
    GTK_SCHEME="prefer-light"
    HELIX_THEME="flexoki_light"
    FG="#B7B5AC"
    BG="#FFFCF0"
    BLK="#FFFCF0"
    RED="#AF3029"
    GRN="#879A39"
    YLW="#D0A215"
    BLU="#4385BE"
    MAG="#CE5D97"
    CYN="#3AA99F"
    WHT="#100F0F"
    ORG="#DA702C"
    NOTIFY_ICON="weather-clear"
  fi
}

send_notification() {
  local mode=$1
  notify-send -u low -i "$NOTIFY_ICON" "System Theme" "Switched to $mode mode"
}

apply_theme() {
  local mode=$1
  load_theme_registry "$mode"

  gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME"
  gsettings set org.gnome.desktop.interface color-scheme "$GTK_SCHEME"

  mkdir -p "$(dirname "$ZELLIJ_DYNAMIC_THEME")"
  cat <<EOF >"$ZELLIJ_DYNAMIC_THEME"
themes {
    dynamic {
        fg "$FG"
        bg "$BG"
        black "$BLK"
        red "$RED"
        green "$GRN"
        yellow "$YLW"
        blue "$BLU"
        magenta "$MAG"
        cyan "$CYN"
        white "$WHT"
        orange "$ORG"
    }
}
EOF
  touch "$ZELLIJ_CONFIG"

  if [[ -f "$HELIX_TEMPLATE" ]]; then
    cp "$HELIX_TEMPLATE" "$HELIX_CONFIG"
    sed -i "s/^theme = .*/theme = \"$HELIX_THEME\"/" "$HELIX_CONFIG" || echo "theme = \"$HELIX_THEME\"" >>"$HELIX_CONFIG"
    pkill -USR1 helix
  fi

  send_notification "$mode"
}

get_current_mode() {
  local scheme
  scheme=$(gsettings get org.gnome.desktop.interface color-scheme)
  [[ "$scheme" == "'prefer-dark'" ]] && echo "dark" || echo "light"
}

case "$1" in
dark | light) apply_theme "$1" ;;
force) [[ $(get_current_mode) == "dark" ]] && apply_theme "light" || apply_theme "dark" ;;
*)
  HOUR=$(date +%H)
  ((HOUR >= 19 || HOUR < 8)) && apply_theme "dark" || apply_theme "light"
  ;;
esac
