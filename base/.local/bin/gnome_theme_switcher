#!/usr/bin/env bash
set_theme() {
  if [[ "$1" == "dark" ]]; then
    NEW_GTK_THEME="adw-gtk3-dark"
    NEW_GTK_SCHEME="prefer-dark"
  elif [[ "$1" == "light" ]]; then
    NEW_GTK_THEME="adw-gtk3"
    NEW_GTK_SCHEME="prefer-light"
  else
    echo "[!] Unsupported theme: $1"
    return
  fi

  export DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS

  echo "$DBUS_SESSION_BUS_ADDRESS"
  CURRENT_GTK_SCHEME=$(gsettings get org.gnome.desktop.interface color-scheme)
  echo "[.] Currently using ${CURRENT_GTK_SCHEME}"
  if [[ "${CURRENT_GTK_SCHEME}" == "'${NEW_GTK_SCHEME}'" ]]; then
    echo "[i] Already using gtk '${NEW_GTK_SCHEME}' theme"
  else
    echo "[-] Setting gtk theme to ${NEW_GTK_SCHEME}"
    gsettings set org.gnome.desktop.interface gtk-theme ${NEW_GTK_THEME} &&
      gsettings set org.gnome.desktop.interface color-scheme ${NEW_GTK_SCHEME}
    echo "[✓] gtk theme changed to ${NEW_GTK_SCHEME}"
  fi
}

# If script run without argument
if [[ -z "$1" ]]; then
  CURRENTTIME=$(date +%H:%M)
  if [[ "$CURRENTTIME" > "17:00" || "$CURRENTTIME" < "09:00" ]]; then
    set_theme dark
  else
    set_theme light
  fi
else
  set_theme "$1"
fi
